{
  "name": "claude-firefox",
  "version": "0.1.0",
  "private": true,
  "description": "Baut die offizielle Claude-Chrome-Extension lokal zu einem Firefox-Add-on um.",
  "type": "module",
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
